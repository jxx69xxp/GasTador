{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/node_modules/:path*",
      "destination": "/assets/nm/:path*"
    },
    {
      "source": "/list/:type",
      "destination": "/list/[type]"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
